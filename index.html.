1px}.muted{color:var(--muted);font-size:13px;line-height:1.6}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.product{background:var(--panel);border:1px solid #292929;overflow:hidden}.product-art{min-height:210px;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 65%,#252525,#0b0b0b 72%);padding:20px}.lightbar{width:90%;height:95px;border-radius:50%;border:2px solid #5f6cf7;box-shadow:0 0 18px #454cf0, inset 0 0 18px #2428b7;transform:perspective(180px) rotateX(48deg);position:relative}.lightbar:before,.lightbar:after{content:"";position:absolute;left:10%;right:10%;height:6px;border-radius:10px;background:#b7baff;box-shadow:0 0 16px #5963ff}.lightbar:before{top:22px}.lightbar:after{bottom:22px}.product:nth-child(2) .lightbar{border-color:#e5e5e5;box-shadow:0 0 18px #999,inset 0 0 18px #555}.product:nth-child(2) .lightbar:before,.product:nth-child(2) .lightbar:after{background:#eee;box-shadow:0 0 14px #fff}.product:nth-child(3) .lightbar{border-color:#ff4eaa;box-shadow:0 0 18px #ff2e9a,inset 0 0 18px #b61969}.product:nth-child(3) .lightbar:before,.product:nth-child(3) .lightbar:after{background:#ffb8df;box-shadow:0 0 14px #ff2e9a}.productinfo{padding:18px}.tag{font-size:10px;letter-spacing:2px;color:#aaa;text-transform:uppercase}.product h3{font-size:17px;margin:9px 0}.productinfo p{color:#aaa;font-size:12px;line-height:1.6;min-height:38px}.price-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:17px}.price{font-size:15px;font-weight:bold}.add{background:transparent;border:1px solid #555;color:white;padding:10px 12px;font-size:11px;font-weight:bold}.notice{margin-top:16px;color:#858585;font-size:11px;line-height:1.6}.about{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;background:#101010;border:1px solid #292929;padding:30px}.aboutmark{font-size:clamp(30px,5vw,55px);font-weight:900;letter-spacing:-2px;color:#aaa}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}.feature{border-top:1px solid #444;padding-top:14px}.feature strong{display:block;font-size:12px;letter-spacing:1px;margin-bottom:7px}.feature span{color:#999;font-size:12px;line-height:1.5}.footer{border-top:1px solid var(--line);padding:27px 0;color:#888;font-size:11px}.footrow{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.cartpanel{display:none;position:fixed;right:14px;top:72px;width:min(360px,calc(100vw - 28px));background:#151515;border:1px solid #555;padding:20px;z-index:5;box-shadow:0 20px 50px #000}.cartpanel.open{display:block}.carttop{display:flex;justify-content:space-between;align-items:center}.cartitems{padding:12px 0;color:#ccc;font-size:13px;line-height:1.7}.close{background:none;border:0;color:white;font-size:22px}.checkout{width:100%;margin-top:10px}.smallprint{font-size:10px;color:#888;line-height:1.6;margin-top:13px}
@media(max-width:720px){.navlinks{display:none}.hero{grid-template-columns:1fr;gap:24px;padding-top:32px}.hero-copy{order:1}.logo-frame{order:0;min-height:240px}.logo-frame img{max-width:270px}.products{grid-template-columns:1fr 1fr}.product-art{min-height:155px}.lightbar{height:65px}.lightbar:before{top:14px}.lightbar:after{bottom:14px}.about{grid-template-columns:1fr;padding:22px}.features{grid-template-columns:1fr}.section{padding:42px 0}}
